---
import { allies } from '../data/site';
---

<section id="aliados" class="section allies">
  <div class="wrap">
    <h2 class="section-title">Aliados y ecosistema</h2>
    <ul>
      {allies.map((a) => <li>{a}</li>)}
    </ul>
  </div>
</section>

<style>
  .section-title {
    font-size: clamp(26px, 3vw, 30px);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  li {
    padding: 14px 26px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-muted);
  }

  @media (max-width: 520px) {
    ul {
      gap: 10px;
    }

    li {
      padding: 10px 16px;
      font-size: 14px;
    }
  }
</style>
