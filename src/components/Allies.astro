---
import { Image } from 'astro:assets';
import { allies } from '../data/site';
---

<section id="aliados" class="section allies">
  <div class="wrap">
    <h2 class="section-title">Aliados y ecosistema</h2>
    <ul>
      {
        allies.map((a) => (
          <li>
            <a href={a.href} target="_blank" rel="noopener" title={a.name}>
              <Image src={a.logo} alt={a.name} height={56} densities={[1, 2]} loading="lazy" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section-title {
    font-size: clamp(26px, 3vw, 30px);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 112px;
    padding: 20px 28px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  a:hover {
    border-color: var(--color-accent-soft);
    box-shadow: 0 10px 24px -18px rgb(31 46 56 / 0.4);
  }

  img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 56px;
    object-fit: contain;
  }

  @media (max-width: 760px) {
    ul {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    a {
      height: 88px;
      padding: 14px 16px;
    }

    img {
      max-height: 44px;
    }
  }
</style>
