---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight, Users } from '@lucide/astro';
import { founders, site } from '../data/site';
---

<section id="comunidad" class="section section--surface">
  <div class="wrap">
    <header class="intro">
      <h2 class="section-title">Miembros fundadores</h2>
      <p class="section-lead">El equipo que impulsa a Piura AI desde su fundación.</p>
    </header>

    <ul class="grid">
      {
        founders.map((f) => (
          <li class="card">
            <Image src={f.photo} alt={`Foto de ${f.name}`} width={112} height={112} densities={[1, 2]} class="avatar" />
            <h3>{f.name}</h3>
            <p class="role">{f.role}</p>
            <p class="bio">{f.bio}</p>
            <a href={f.linkedin} target="_blank" rel="noopener">
              Perfil de LinkedIn <span class="sr-only">de {f.name}</span>
              <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          </li>
        ))
      }
      <li class="card card--join">
        <span class="join-icon"><Users size={26} stroke-width={1.5} aria-hidden="true" /></span>
        <h3>Súmate a Piura AI</h3>
        <p class="bio">La comunidad crece con cada persona que comparte, aprende y construye con IA en la región.</p>
        <a href={site.joinUrl} target="_blank" rel="noopener">Unirse a la comunidad <ArrowRight size={14} aria-hidden="true" /></a>
      </li>
    </ul>
  </div>
</section>

<style>
  .intro {
    margin-bottom: 48px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: 22px;
  }

  .card :global(.avatar) {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--color-surface), 0 0 0 3px var(--color-line);
  }

  .card--join {
    grid-column: span 2;
    background: var(--color-navy);
  }

  .card--join h3 {
    color: #fff;
  }

  .card--join .bio {
    color: var(--color-on-dark-muted);
  }

  .card--join a {
    color: var(--color-accent-soft);
  }

  .card--join a:hover {
    color: #fff;
  }

  .join-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--color-accent-soft);
  }

  h3 {
    margin-top: 14px;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .role {
    margin-top: 4px;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-accent);
  }

  .bio {
    margin: 8px 0 12px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .card a {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 13px;
    font-weight: 500;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .card--join {
      grid-column: auto;
    }
  }
</style>
