---
import { stats } from '../data/site';
---

<section class="stats" aria-label="Piura AI en cifras">
  <dl class="wrap stats__grid">
    {
      stats.map((s) => (
        <div class="stats__item">
          <dt>{s.label}</dt>
          <dd class:list={{ small: s.small }}>{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .stats {
    margin-top: clamp(56px, 7vw, 80px);
    background: var(--color-surface);
    border-block: 1px solid var(--color-line);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-block: 0;
    padding-block: 40px;
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding-inline: 24px;
    border-left: 1px solid var(--color-line);
  }

  .stats__item:first-child {
    padding-left: 0;
    border-left: 0;
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-navy);
  }

  dd.small {
    font-size: 28px;
  }

  dt {
    margin-top: 6px;
    font-size: 14px;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .stats__grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 28px;
      padding-block: 32px;
    }

    .stats__item:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    dd {
      font-size: 28px;
    }

    dd.small {
      font-size: 22px;
    }
  }
</style>
