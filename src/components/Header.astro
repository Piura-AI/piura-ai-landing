---
import { Menu, X } from '@lucide/astro';
import { nav, site } from '../data/site';
---

<header class="header">
  <nav class="wrap header__inner" aria-label="Navegación principal">
    <a href="/" class="header__brand" aria-label="Piura AI, ir al inicio">
      <img src="/brand/piura-ai-logo.svg" alt="Piura AI" width="98" height="40" />
    </a>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="menu-principal">
      <Menu class="icon-open" size={24} aria-hidden="true" />
      <X class="icon-close" size={24} aria-hidden="true" />
      <span class="sr-only">Abrir menú</span>
    </button>

    <div class="header__menu" id="menu-principal">
      <ul class="header__links">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <a href={site.joinUrl} class="btn btn--primary" target="_blank" rel="noopener">Unirse a la comunidad</a>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--color-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }

  .header__brand img {
    height: 40px;
    width: auto;
  }

  .header__menu {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .header__links {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__links a {
    color: var(--color-muted);
    font-size: 15px;
    font-weight: 500;
  }

  .header__links a:hover {
    color: var(--color-ink);
    text-decoration: none;
  }

  .header__toggle {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    margin-right: -8px;
    color: var(--color-navy);
    cursor: pointer;
  }

  .header__toggle .icon-close {
    display: none;
  }

  @media (max-width: 900px) {
    .header__toggle {
      display: inline-flex;
    }

    .header__menu {
      display: none;
      position: absolute;
      inset: var(--header-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      padding: 16px var(--gutter) 24px;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-line);
      box-shadow: 0 16px 24px -20px rgb(31 46 56 / 0.35);
    }

    .header__links {
      flex-direction: column;
      gap: 0;
    }

    .header__links a {
      display: block;
      padding: 12px 0;
      font-size: 17px;
      border-bottom: 1px solid var(--color-line);
    }

    .header.is-open .header__menu {
      display: flex;
    }

    .header.is-open .icon-open {
      display: none;
    }

    .header.is-open .icon-close {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const toggle = header?.querySelector<HTMLButtonElement>('.header__toggle');
  const label = toggle?.querySelector('.sr-only');

  const setOpen = (open: boolean) => {
    header?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
  };

  toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
  header?.querySelectorAll('.header__menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
