---
import { ArrowUpRight, CalendarDays } from '@lucide/astro';
import { events } from '../data/site';
---

<section id="eventos" class="section section--surface">
  <div class="wrap">
    <header class="head">
      <h2 class="section-title">Próximos eventos</h2>
      <span class="head__note"><CalendarDays size={16} aria-hidden="true" /> Agenda activa</span>
    </header>

    <div class="grid">
      {
        events.map((e) => (
          <article class="card">
            <span class="tag">{e.tag}</span>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
            <div class="card__foot">
              <a href={e.href} target="_blank" rel="noopener">
                Registrarse <span class="sr-only">en {e.title}</span>
                <ArrowUpRight size={16} aria-hidden="true" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 48px;
  }

  .head__note {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--color-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-cream);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 32px;
  }

  .tag {
    align-self: flex-start;
    font-size: 12.5px;
    color: var(--color-navy);
    border: 1px solid var(--color-navy);
    border-radius: 999px;
    padding: 4px 12px;
  }

  h3 {
    margin-top: 18px;
    font-size: 21px;
    font-weight: 600;
    color: var(--color-ink);
  }

  p {
    margin: 10px 0 22px;
    font-size: 15px;
    color: var(--color-muted);
  }

  .card__foot {
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--color-line);
  }

  .card__foot a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .card {
      padding: 24px;
    }
  }
</style>
